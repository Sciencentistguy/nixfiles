+      mastering->primaries.w_x = primaries->default_white.x;
+      mastering->primaries.w_y = primaries->default_white.y;
+    }
+
+  if (max_fall > 0.0f)
+    {
+      mastering->has_max_fall = TRUE;
+      mastering->max_fall = max_fall;
+    }
