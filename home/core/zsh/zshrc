autoload -U compinit
compinit

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt AUTO_PUSHD
setopt SHARE_HISTORY
setopt extendedglob

unsetopt nomatch

zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select

# .zshenv already did this, but macOS's /etc/zprofile (path_helper) reorders
# PATH afterwards
source "$HOME/.zsh/path.zsh"

export GPG_TTY=$(tty)
export MAKEFLAGS="-j$(nproc)"

# Prompt
eval "$(starship init zsh)"
RPROMPT=""

# Aliases
source ~/.zsh/aliases.zsh

# Functions
source ~/.zsh/functions.zsh

if [[ $OSTYPE == darwin* && -f /etc/static/zshrc ]]; then
    source /etc/static/zshrc
fi

if [[ -f $HOME/.config/python/startup.py ]]; then
    export PYTHONSTARTUP="$HOME/.config/python/startup.py"
fi

zle -N sudo-command-line
bindkey "\e\e" sudo-command-line
bindkey -M vicmd '\e\e' sudo-command-line

for file in /etc/zsh/zshrc.d/*(N); do
    source "$file"
done

if [[ -z $SSH_AUTH_SOCK ]]; then
    eval "$(ssh-agent)" >/dev/null
fi

# Plugins
source ~/.zsh/plugins.zsh

# mosh-server doesn't pass XDG_RUNTIME_DIR through, which stops atuin finding
# its daemon socket
if [[ -z "$XDG_RUNTIME_DIR" && -d "/run/user/$UID" ]]; then
    export XDG_RUNTIME_DIR="/run/user/$UID"
fi

if (( $+commands[atuin] )); then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

if (( $+commands[nix-your-shell] )); then
    eval "$(nix-your-shell zsh)"
fi

_atuin_history_step() {
    local dir=$1
    if [[ $LASTWIDGET != _atuin_up && $LASTWIDGET != _atuin_down ]]; then
        _atuin_prefix=$BUFFER
        _atuin_offset=-1
    fi
    (( _atuin_offset += dir ))
    if (( _atuin_offset < 0 )); then
        _atuin_offset=-1
        BUFFER=$_atuin_prefix
        CURSOR=$#BUFFER
        return
    fi
    local entry
    entry=$(atuin search --cmd-only --search-mode prefix --filter-mode global --author '$all-user' \
        --limit 1 --offset $_atuin_offset -- "$_atuin_prefix" 2>/dev/null)
    if [[ -n $entry ]]; then
        BUFFER=$entry
        CURSOR=$#BUFFER
    else
        (( _atuin_offset -= dir ))
    fi
}
_atuin_up() { _atuin_history_step 1 }
_atuin_down() { _atuin_history_step -1 }
zle -N _atuin_up
zle -N _atuin_down

function zvm_after_init() {
    zvm_bindkey viins '^R' atuin-search-viins
    zvm_bindkey vicmd '^R' atuin-search-vicmd
}

zvm_after_init_commands+=(
    "bindkey '^[[A' _atuin_up"
    "bindkey '^[[B' _atuin_down"
    "bindkey '^[OH' beginning-of-line"
    "bindkey '^[OF' end-of-line"
    "bindkey '^[[H' beginning-of-line"
    "bindkey '^[[F' end-of-line"
)
