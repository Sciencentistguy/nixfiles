autoload -U compinit
compinit

setopt AUTO_PUSHD
setopt SHARE_HISTORY
setopt extendedglob

unsetopt nomatch

zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select

# Path
if [ -z "${IN_NIX_SHELL}" ]; then
    #TODO: `nix shell` does not set IN_NIX_SHELL
    source "$HOME/.zsh/path.zsh"
fi

# Prompt
eval "$(starship init zsh)"
RPROMPT=""

# Aliases
source ~/.zsh/aliases.zsh

# Functions
source ~/.zsh/functions.zsh

# Environment
source ~/.zsh/environment.zsh

if [[ $(uname) == "Darwin" ]]; then
    if [ -f "/etc/static/zshrc" ]; then
        source "/etc/static/zshrc"
    fi
fi

if type clang >/dev/null; then
    export CC=clang
    export CXX=clang++
fi

if [ -f "$HOME/.config/python/startup.py" ]; then
    export PYTHONSTARTUP="$HOME/.config/python/startup.py"
fi

if [ -d "/etc/nix/path" ]; then
    export NIX_PATH="/etc/nix/path"
fi

zle -N sudo-command-line
bindkey "\e\e" sudo-command-line
bindkey -M vicmd '\e\e' sudo-command-line

if [ -d /etc/zsh/zshrc.d ]; then
    for file in /etc/zsh/zshrc.d/*; do
        source $file
    done
fi

if [[ -z $SSH_AUTH_SOCK ]]; then
    eval "$(ssh-agent)" >/dev/null
fi

# Command-not-found
if [ -f ~/.zsh/command-not-found.zsh ]; then
    source ~/.zsh/command-not-found.zsh
fi

# Plugins
source ~/.zsh/plugins.zsh

# mosh-server doesn't pass XDG_RUNTIME_DIR through, which stops atuin finding
# its daemon socket
if [[ -z "$XDG_RUNTIME_DIR" && -d "/run/user/$UID" ]]; then
    export XDG_RUNTIME_DIR="/run/user/$UID"
fi

if type atuin >/dev/null; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

_atuin_history_step() {
    local dir=$1
    if [[ $LASTWIDGET != _atuin_up && $LASTWIDGET != _atuin_down ]]; then
        _atuin_prefix=$BUFFER
        _atuin_offset=-1
    fi
    (( _atuin_offset += dir ))
    if (( _atuin_offset < 0 )); then
        _atuin_offset=-1
        BUFFER=$_atuin_prefix
        CURSOR=$#BUFFER
        return
    fi
    local entry
    entry=$(atuin search --cmd-only --search-mode prefix --filter-mode global \
        --limit 1 --offset $_atuin_offset -- "$_atuin_prefix" 2>/dev/null)
    if [[ -n $entry ]]; then
        BUFFER=$entry
        CURSOR=$#BUFFER
    else
        (( _atuin_offset -= dir ))
    fi
}
_atuin_up() { _atuin_history_step 1 }
_atuin_down() { _atuin_history_step -1 }
zle -N _atuin_up
zle -N _atuin_down

function zvm_after_init() {
    zvm_bindkey viins '^R' atuin-search-viins
    zvm_bindkey vicmd '^R' atuin-search-vicmd
}

zvm_after_init_commands+=(
    "bindkey '^[[A' _atuin_up"
    "bindkey '^[[B' _atuin_down"
    "bindkey '^[OH' beginning-of-line"
    "bindkey '^[OF' end-of-line"
    "bindkey '^[[H' beginning-of-line"
    "bindkey '^[[F' end-of-line"
)
